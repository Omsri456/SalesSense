# Copy this file to .env and fill in real values.
# Never commit the actual .env file — it's in .gitignore for a reason.

# MongoDB connection string (local or Atlas free tier)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=salessense

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Hugging Face (only needed if the dataset requires auth — FreshRetailNet-50K is public, so likely unused)
HF_TOKEN=

# Model training
LSTM_EPOCHS=100
LSTM_EARLY_STOPPING_PATIENCE=10
